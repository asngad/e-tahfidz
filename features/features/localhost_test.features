import { Given, When, Then, Before, After } from '@cucumber/cucumber';
import { chromium, Browser, Page, expect } from '@playwright/test';

let browser: Browser;
let page: Page;

// Hook dijalankan sebelum setiap skenario
Before(async function () {
  // Set headless: false agar browser terbuka dan terlihat saat testing
  browser = await chromium.launch({ headless: false, slowMo: 300 });
  const context = await browser.newContext();
  page = await context.newPage();
});

// Hook dijalankan setelah setiap skenario
After(async function () {
  await page.close();
  await browser.close();
});

Given('Pengguna mengakses aplikasi lokal di {string}', async function (url: string) {
  await page.goto(url);
  // Menunggu hingga network idle (memastikan Vite/React selesai load)
  await page.waitForLoadState('networkidle');
});

Then('Elemen tombol dengan teks {string} harus terlihat', async function (buttonText: string) {
  const button = page.getByRole('button', { name: new RegExp(buttonText, 'i') });
  await expect(button).toBeVisible();
});

When('Pengguna mengklik tombol {string}', async function (buttonText: string) {
  const button = page.getByRole('button', { name: new RegExp(buttonText, 'i') });
  await button.click();
});

Then('Teks tombol berubah menjadi {string}', async function (expectedText: string) {
  const button = page.getByRole('button', { name: expectedText });
  await expect(button).toBeVisible();
});